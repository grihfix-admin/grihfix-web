# .env.example — GrihFix v2
# Copy this to `.env.local` and fill in real values. `.env.local` is
# gitignored (see .gitignore's `.env*` rule) and must never be committed.

# --- Database ---
# Full MongoDB Atlas (or self-hosted) connection string.
MONGODB_URI=

# --- Admin auth ---
# Random 40+ character string used to sign admin session tokens.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Only this email address can log into /admin.
ADMIN_LOGIN_EMAIL=

# --- Outbound email (booking notifications, admin OTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Use a Gmail "App Password", not your normal account password.
SMTP_PASS=
BOOKING_FROM_EMAIL="GrihFix <no-reply@grihfix.com>"
BOOKING_NOTIFY_EMAIL=

# --- Site URL ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Optional: WhatsApp/SMS via Twilio ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# WHATSAPP_BUSINESS_NUMBER=
